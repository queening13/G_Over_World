# 이 파일을 .env 로 복사해서 값을 채운 뒤
#   node --env-file=.env server.mjs
# 로 실행한다. .env 는 .gitignore 에 들어 있다 — 절대 커밋하지 말 것.

# MongoDB Atlas 연결 문자열.
# 비우거나 줄을 지우면 data/ 폴더에 파일로 저장한다.
#   · <db_password> 자리에 실제 비밀번호를 넣는다
#   · 비밀번호에 @ # / : ? & % 가 있으면 퍼센트 인코딩해야 한다
#     @ → %40   # → %23   / → %2F   : → %3A   ? → %3F   & → %26   % → %25
MONGODB_URI=mongodb+srv://사용자명:비밀번호@클러스터.xxxxx.mongodb.net/?retryWrites=true&w=majority

# 선택 — 기본값을 쓰려면 지워도 된다
# MONGODB_DB=gover
# MONGODB_COLLECTION=saves
# SAVE_DIR=./data
# PORT=8788
